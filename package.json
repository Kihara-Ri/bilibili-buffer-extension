{
  "name": "haineicunzhi",
  "version": "2.15.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "dev": "node scripts/dev-reload-server.mjs",
    "build": "node scripts/build-release.mjs && node scripts/verify-release.mjs",
    "verify": "node scripts/verify-release.mjs",
    "icons": "node scripts/build-icons.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "node scripts/build-site.mjs --preview",
    "test:site": "node tests/run-site-check.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:popup": "node tests/run-popup-stability.mjs && node tests/run-review-prompt.mjs",
    "test:network": "node tests/run-playback-network.mjs && node tests/run-playback-demand.mjs",
    "test:playback": "node tests/run-playback-cache-integration.mjs",
    "test:extension": "npm run build && node tests/run-playback-extension-smoke.mjs",
    "test:live": "node scripts/live-cache.mjs",
    "test:chrome": "node scripts/test-chrome.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/check-browser-compat.mjs",
    "build:github": "node scripts/build-release.mjs --github",
    "update:key": "node scripts/github-update-key.mjs",
    "test:updater": "node tests/run-github-updater.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
